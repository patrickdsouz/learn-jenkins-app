pipeline {
    agent any

    stages {
        stage('Build') {
            agent {
                docker {
                    image 'node:18-alpine'
                    args '-u node'
                    reuseNode true
                }
                
            }
            steps {
                sh '''
                ls -la
                node --version
                npm --version
                # Clean workspace to avoid stale node_modules
                rm -rf node_modules package-lock.json
                npm config set cache /tmp/.npm-cache --global
                npm ci --no-audit --no-fund
                npm run build --if-present
                ls -la
                '''
            }
        }
    }
}
